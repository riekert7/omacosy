#!/usr/bin/env bash
# omacosy-ghostty-theme — render the active omarchy theme's colors.toml into a
# Ghostty theme file, so the terminal carries the same palette as the bar,
# the borders and the wallpaper. The Ghostty config just says
# `theme = omacosy` and never has to change again.
#
# The file is written into the REPO's config/ghostty/themes/ (gitignored, the
# same trick aerospace.toml uses) because install.sh copies that directory
# with `rm -rf` + `cp -R` — anything written only to ~/.config/ghostty is
# erased by the next update. The live copy is refreshed too, so a theme
# switch takes effect without a reinstall.
#
# Ghostty has no reload-config CLI action and does not watch its config, so
# the new palette lands on the next Cmd+Shift+, (reload_config) or the next
# window. Existing windows keeping the old colours is Ghostty's behaviour,
# not a failed write.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEME_DIR="${1:-$HOME/.config/omarchy/current/theme}"
SRC="$THEME_DIR/colors.toml"
[ -f "$SRC" ] || { echo "omacosy-ghostty-theme: no colors.toml in $THEME_DIR" >&2; exit 1; }

# colors.toml is flat `key = "#rrggbb"` — read it without a TOML parser, and
# accept only a 6-digit hex so a theme pack cannot inject config lines.
val() { sed -n "s/^$1 *= *\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$SRC" | head -1; }

render() {
  echo "# generated by omacosy-ghostty-theme from $(basename "$(readlink -f "$THEME_DIR")") — do not edit"
  for k in background foreground; do
    v="$(val "$k")"; [ -n "$v" ] && echo "$k = $v"
  done
  v="$(val cursor)";               [ -n "$v" ] && echo "cursor-color = $v"
  v="$(val selection_background)"; [ -n "$v" ] && echo "selection-background = $v"
  v="$(val selection_foreground)"; [ -n "$v" ] && echo "selection-foreground = $v"
  for i in $(seq 0 15); do
    v="$(val "color$i")"; [ -n "$v" ] && echo "palette = $i=$v"
  done
}

for dir in "$REPO_DIR/config/ghostty/themes" "$HOME/.config/ghostty/themes"; do
  mkdir -p "$dir"
  render > "$dir/omacosy"
done
