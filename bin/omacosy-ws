#!/usr/bin/env bash
# Workspace switching. ONE global set of nine, omarchy-style: a
# workspace belongs to whichever monitor its windows are on, and Super+N
# follows it there rather than acting on the focused display. This is
# hyprland's model — see aerospace.toml, which no longer pins anything
# with workspace-to-monitor-force-assignment.
set -euo pipefail
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"
slot="${1:-}"
op="${2:-switch}"

# A window moved between two HIDDEN workspaces changes nothing on
# screen, so the window server has no event to give the bar and its
# workspace icons would sit stale. Builtin redirect, no extra process.
moved() { : > /tmp/omacosy-bar-moved; }

# OmniWM path: its switch-workspace / move-to-workspace already act on
# the focused monitor's numeric slot (per-monitor workspace model — no
# 11-19 twin math needed), so those route through omniwmctl. throw and
# throw-all have no slot-twin IPC equivalent — they stand down. `|| true`
# because IPC may be off; a dead key beats error spam on every press.
# a live OmniWM answers its socket in ~3 ms; pgrep -f scanned every
# process for 31 ms per call, and a stale socket after a crash cannot
# fool a real request the way a file test could
wm_is_omniwm() { "$HOME/.local/bin/omacosy-omni" active >/dev/null 2>&1; }
if wm_is_omniwm; then
  # everything goes through omacosy-omni — a held-socket C client that
  # launches in ~3 ms where omniwmctl needs ~10 ms and the old
  # shell-and-python cycle needed ~80 ms. The slot-scoped cycle (1-9
  # stays in 1-9, guests in guests, wrapping) lives in helper/gesture/
  # omniwm.c, shared with the gesture daemon, so a swipe and Super+Tab
  # cannot disagree. No bar poke: the bar follows OmniWM's
  # workspace-bar channel, which fires for empties too.
  OMNI="$HOME/.local/bin/omacosy-omni"
  case "$slot" in next | prev) op="$slot" ;; esac
  case "$op" in
    switch) "$OMNI" command switch-workspace "{\"workspaceNumber\":$slot}" >/dev/null 2>&1 || true ;;
    move) "$OMNI" command move-to-workspace "{\"workspaceNumber\":$slot}" >/dev/null 2>&1 || true ;;
    next | prev)
      r="$("$OMNI" "$op" 2>&1)" || true
      echo "$(date +%T) op=$op resp='$(echo "$r" | head -c 120)'" >> /tmp/omacosy-ws.log ;;
  esac
  exit 0
fi

case "$op" in
  switch)
    # An OCCUPIED workspace lives on a monitor and you go to it — focus
    # crosses displays, which is hyprland's `workspace N` and what makes
    # a workspace feel "stuck" to its screen until thrown.
    #
    # An EMPTY one is different. hyprland has no empty workspaces: the
    # number is conjured on the monitor you are standing on. aerospace
    # instead parks every unassigned workspace on `main` (its docs:
    # "by default, all workspaces are assigned to the 'main' monitor"),
    # so a bare `workspace 6` teleported you to the laptop. summon-
    # workspace moves it to the FOCUSED monitor and focuses it, which is
    # the hyprland behaviour.
    if [ -n "$("$A" list-windows --workspace "$slot" --format '%{window-id}' 2>/dev/null)" ]; then
      "$A" workspace "$slot"
    else
      "$A" summon-workspace "$slot"
    fi
    ;;
  move)
    "$A" move-node-to-workspace --focus-follows-window "$slot"
    moved
    ;;
  next | prev) # omarchy's Super+Tab / Super+Shift+Tab (hyprland e+1/e-1)
    "$A" workspace --wrap-around "$op"
    ;;
esac
